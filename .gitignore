FodyWeavers.xsd

####################
## Windows Forms
####################

# IMPORTANT: Do NOT ignore Designer.cs files - they contain UI layout!
# These are essential for Windows Forms applications
# !*Designer.cs (commented out - we KEEP these files)

# Temporary files created by Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.tmp

# Folder config file
[Dd]esktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows Installer files
*.cab
*.msi
*.msix
*.msm
*.msp

# Windows shortcuts
*.lnk

####################
## macOS
####################

.DS_Store
.AppleDouble
.LSOverride

# Icon must end with two \r
Icon

# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

####################
## Linux
####################

*~

# temporary files which can be created if a process still has a handle open of a deleted file
.fuse_hidden*

# KDE directory preferences
.directory

# Linux trash folder which might appear on any partition or disk
.Trash-*

# .nfs files are created when an open file is removed but is still being accessed
.nfs*

####################
## JetBrains Rider
####################

.idea/
*.sln.iml

####################
## Sensitive Data
####################

# Configuration files that may contain sensitive data
# Uncomment these if you don't want to commit connection strings or API keys
# App.config
# Web.config
# appsettings.json
# appsettings.*.json

# Firebase configuration (if it contains sensitive data)
# FBConfig.cs

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Database files (if storing locally)
*.db
*.sqlite
*.sqlite3

####################
## Project Specific
####################

# Firebase DLLs with hardcoded paths (these should be managed via NuGet instead)
# Uncomment if you want to ignore these
# Firebase.dll
# Firebase.Auth.dll
# Firebase.Storage.dll

# Application logs
logs/
*.log

# Backup files
*.bak
*.backup
*~

####################
## Keep These Files
####################

# Explicitly keep important files that might be ignored by wildcards above
!.gitignore
!.gitattributes

# Keep all Designer.cs files (critical for Windows Forms)
!*Designer.cs

# Keep all .resx resource files (critical for Windows Forms)
!*.resx

# Keep configuration templates
!App.config.template
!Web.config.template

# Keep package configuration
!packages.config

# Keep solution and project files
!*.sln
!*.csproj
!*.vbproj
!*.fsproj
